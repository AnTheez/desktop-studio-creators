{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Desktop Studio creator contract v1",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "format": "portable-path",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$))(?!.*:)[^\\u0000-\\u001f\\u007f<>\"|?*]+$"
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "systemMetrics",
          "input",
          "network",
          "storage"
        ]
      }
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 32,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 10000
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$" }
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "preview": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "formatVersion",
        "id",
        "type",
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "property": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "slider",
            "color",
            "boolean",
            "number",
            "text",
            "select"
          ]
        },
        "default": {},
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
