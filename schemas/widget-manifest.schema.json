{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Desktop Studio DOM Widget manifest v1",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "widget"
        },
        "entryPoint": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "defaultSize": {
          "$ref": "common.schema.json#/$defs/size"
        },
        "settings": {
          "$ref": "common.schema.json#/$defs/path"
        },
        "runtime": {
          "const": "dom"
        },
        "permissions": {
          "$ref": "common.schema.json#/$defs/permissions"
        },
        "properties": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/property"
          }
        },
        "animations": {},
        "behavior": {},
        "stateMachine": {}
      },
      "required": [
        "entryPoint",
        "defaultSize"
      ],
      "additionalProperties": true
    }
  ]
}
